# ---------------------------------------------------------------------------
# Open Design Studio — copy this file to `.env` and fill in what you have.
# Nothing here is required: a missing key just disables that provider and the
# platform falls back to the next free option.
# ---------------------------------------------------------------------------

# --- LLM / copywriting (Llama) ---------------------------------------------
# Free key: https://console.groq.com/keys  (recommended, fastest)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# Free models: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Offline option (https://ollama.com)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# --- Image generation ------------------------------------------------------
# The synchronous gateway in front of ComfyUI.
COMFYUI_GATEWAY_URL=http://127.0.0.1:8100
# Where ComfyUI actually runs (the Colab tunnel URL, see notebooks/).
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_CKPT=sd_xl_base_1.0.safetensors

# Free keyless fallback used when ComfyUI is unavailable.
POLLINATIONS_URL=https://image.pollinations.ai/prompt

# --- Image cleanup (rembg + Real-ESRGAN) -----------------------------------
CLEANUP_URL=http://127.0.0.1:8000
REMBG_MODEL=u2net
# Optional: path to the realesrgan-ncnn-vulkan binary for true HD upscaling.
SR_BIN=

# --- Output ----------------------------------------------------------------
OUTPUT_DIR=./app/outputs
REQUEST_TIMEOUT=600

# --- n8n -------------------------------------------------------------------
# Required so workflows can read $env.COMFYUI_GATEWAY_URL etc.
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
# Timezone for n8n
GENERIC_TIMEZONE=Asia/Kathmandu
